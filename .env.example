#!/bin/zsh
# .env.example — Copy to .env and update the 1Password item names to match yours.
# Usage: source .env
# This file is gitignored — never commit your real .env.
#
# Secrets are pulled from 1Password via the op CLI on demand.
# Prerequisites:
#   brew install 1password-cli
#   op signin   (or use the 1Password desktop app integration)
#
# Non-secret config (model names, flags, URLs) are plain exports.

# ── Anthropic / Claude ────────────────────────────────────────────────────────
export ANTHROPIC_API_KEY="$(op item get 'ANTHROPIC_API_KEY' --fields 'password')"
export CLAUDE_MODEL=claude-opus-4-6

# ── Google / Gemini ───────────────────────────────────────────────────────────
export GOOGLE_API_KEY="$(op item get 'GOOGLE_API_KEY' --fields 'password')"
export GEMINI_MODEL=gemini-2.5-pro

# ── Local LM Studio ───────────────────────────────────────────────────────────
# Start LM Studio → Local Server tab → Start Server
export LM_STUDIO_BASE_URL=http://localhost:1234/v1
export LM_STUDIO_MODEL=local-model
export LM_STUDIO_API_KEY=lm-studio
# Human-readable display name for the local LLM button in the frontend UI.
# Set this to whatever model you have loaded in LM Studio (e.g. "Llama 3.3 70B").
export LOCAL_LLM_DISPLAY_NAME="Local LLM"

# ── AWS ───────────────────────────────────────────────────────────────────────
export AWS_ACCESS_KEY_ID="$(op item get 'AWS_ACCESS_KEY_ID' --fields 'password')"
export AWS_SECRET_ACCESS_KEY="$(op item get 'AWS_SECRET_ACCESS_KEY' --fields 'password')"
export AWS_REGION=eu-west-1
export S3_BUCKET=craicgpt-ie-production
export CLOUDFRONT_DISTRIBUTION_ID="$(op item get 'CLOUDFRONT_DISTRIBUTION_ID' --fields 'password')"

# ── Telegram notifications ────────────────────────────────────────────────────
# The .75 engine fans edition-lifecycle alerts (draft generated / published /
# HELD) out to BOTH agents' channels so an editorial HOLD is never silent. Each
# agent has its OWN bot; both DM the same operator chat (the bots' allowlisted
# recipient). Leave unset to disable (notifications become a quiet no-op).
export TELEGRAM_OPENCLAW_BOT_TOKEN="$(op item get 'Telegram bots' --vault AgentCredentials --fields 'openclaw_token' --reveal)"
export TELEGRAM_HERMES_BOT_TOKEN="$(op item get 'Telegram bots' --vault AgentCredentials --fields 'hermes_token' --reveal)"
export TELEGRAM_CHAT_ID="$(op item get 'Telegram bots' --vault AgentCredentials --fields 'allowlist' --reveal)"

# ── Pipeline Behaviour ────────────────────────────────────────────────────────
# DRY_RUN=true  → writes to /tmp instead of uploading to S3 (good for testing)
export DRY_RUN=false
export SKIP_LOCAL_LLM=false
export WEATHER_LOCATION=Dublin
# LLM_MAX_TOKENS: set high for thinking models (gemini-2.5-pro uses tokens on
# internal reasoning before responding — 1024 is exhausted before any output).
export LLM_MAX_TOKENS=8192
