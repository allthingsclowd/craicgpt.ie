# .env.example — Copy to .env and fill in your values.
# The .env file is gitignored — never commit it.

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-opus-4-6

# ── Google / Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy-your-key-here
GEMINI_MODEL=gemini-2.5-pro

# ── Local LM Studio ───────────────────────────────────────────────────────────
# Start LM Studio → Local Server tab → Start Server
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=lm-studio

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA-your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_REGION=eu-west-1
S3_BUCKET=craicgpt-ie-production
CLOUDFRONT_DISTRIBUTION_ID=

# ── Pipeline Behaviour ────────────────────────────────────────────────────────
# DRY_RUN=true  → writes to /tmp instead of uploading to S3 (good for testing)
DRY_RUN=false
SKIP_LOCAL_LLM=false
WEATHER_LOCATION=Dublin
