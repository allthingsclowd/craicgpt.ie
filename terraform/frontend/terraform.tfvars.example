# terraform.tfvars.example
# Copy to terraform.tfvars and uncomment/update values as needed.
# terraform.tfvars is gitignored — never commit it.
#
# After applying, copy the outputs into GitHub:
#   terraform output frontend_s3_bucket_name             → GitHub Variable: S3_BUCKET
#   terraform output frontend_cloudfront_distribution_id → GitHub Secret:   CLOUDFRONT_DISTRIBUTION_ID

# aws_region    = "eu-west-1"
# project_name  = "craicgpt-frontend"
# environment   = "prod"
# domain_name   = "craicgpt.ie"

# cloudfront_aliases = ["craicgpt.ie"]

# ── Module toggles ──────────────────────────────────────────────────────────────
# enable_acm        = true
# enable_s3         = true
# enable_cloudfront = true

# ── S3 ──────────────────────────────────────────────────────────────────────────
# s3_bucket_name_override   = "craicgpt-ie-production"
# s3_enable_versioning      = true
# s3_website_index_document = "index.html"
# s3_website_error_document = "error.html"

# ── CloudFront ───────────────────────────────────────────────────────────────────
# cloudfront_default_root_object = "index.html"
# cloudfront_price_class         = "PriceClass_100"   # US/EU/CA edges only (cheapest)
