# =============================================================================
# CraicGPT.ie Project .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python / Lambda Functions
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.pytest_cache/
*.egg-info/
dist/
build/

# AWS Lambda deployment packages
*.zip
function.zip
deployment-package.zip

# -----------------------------------------------------------------------------
# JavaScript / Node.js / Frontend
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
*.tgz
package-lock.json.bak

# Build outputs
dist/
build/
out/
.cache/
.next/
.nuxt/
.parcel-cache/

# -----------------------------------------------------------------------------
# Terraform Infrastructure  
# -----------------------------------------------------------------------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!terraform.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc

# -----------------------------------------------------------------------------
# Environment & Configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# AWS credentials and config
.aws/
aws-exports.js

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.nfs*

# -----------------------------------------------------------------------------
# Editor / IDE Files
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ IDEA / PyCharm / WebStorm
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Testing & Coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
lcov-report/
htmlcov/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# -----------------------------------------------------------------------------
# Database Files
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Backup Files
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*.orig

# -----------------------------------------------------------------------------
# Compressed Files (unless intentionally tracked)
# -----------------------------------------------------------------------------
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
!static_assets/**/*.zip  # Allow zips in static assets if needed

